      "at": 360,
      "steps": [
        {
          "number": 1,
          "at": 550,
          "line": "Cari orang yang memberi arahan.",
          "detail": "Dengar nomor antrean yang diulang."
        },
        {
          "number": 2,
          "at": 852,
          "line": "Cek jalan keluar sebelum maju.",
          "detail": "Susuri tembok luar menuju jalur samping rel."
        },
        {
          "number": 3,
          "at": 1083,
          "line": "Tinggalkan tanda untuk orang berikutnya.",
          "detail": "Tulis peringatan dengan serpihan batu putih."
        }
      ]
    },
    "ending": {
      "at": 1650,
      "twistAt": 1752,
      "payoff": "Survivor mundur lewat jalur rel; jolt barisan baru terjadi setelah narasi."
    }
  },
