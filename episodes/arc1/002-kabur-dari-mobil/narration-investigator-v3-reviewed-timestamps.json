  "chunks": [
    {
      "index": 0,
      "tag": null,
      "text": "Ada zombie, jangan buka pintu. Mobilmu terkunci di tol yang macet. Satu bunyi bisa membuatnya tahu kapan kamu bergerak.",
      "start": 0,
      "end": 9.745,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 1,
      "tag": null,
      "text": "Ada tiga langkah sebelum celah di samping mobil tertutup. Kalau kamu panik, dia mungkin bereaksi lebih dulu. Pertama, alihkan pandangan dari spion.",
      "start": 9.905,
      "end": 21.87,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 2,
      "tag": null,
      "text": "Tatap dasbor seperti kamu masih menunggu. Dari sudut mata, gadis itu tetap tersenyum. Kedua, tahan pengait sabuk saat melepasnya supaya tidak membentur pintu.",
      "start": 22.03,
      "end": 35.855,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 3,
      "tag": null,
      "text": "Buka kunci pintumu saja. Pegang gagang sampai celah terbuka. Ketiga, raih tas berisi botol dan ponsel.",
      "start": 36.015,
      "end": 44.34,
      "retries": 2,
      "status": "verified"
    },
    {
      "index": 4,
      "tag": null,
      "text": "Merunduklah keluar, lalu lewat sela mobil menuju truk boks. Di balik truk, kamu minum dan memeriksa peta. Tetap berjongkok.",
      "start": 44.5,
      "end": 54.025,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 5,
      "tag": null,
      "text": "Di sebelahmu ada mobil kosong dengan kaca setengah terbuka. Dari kursi belakangnya yang gelap, terdengar bunyi sabuk pengaman dilepas.",
      "start": 54.185,
      "end": 64.85,
      "retries": 2,
      "status": "verified"
    }
  ],
