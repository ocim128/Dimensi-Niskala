  "script": {
    "format": "survival-tactics-curiosity-gap",
    "hook": {
      "at": 0,
      "line": "Saat dengar teriakan dari rumah terkunci, jangan sahut."
    },
    "promise": {
      "at": 90,
      "line": "Kamu perlu lewat gang ini untuk sampai ke jembatan penyeberangan.",
      "openLoop": "Siapa di balik suara yang berulang?"
    },
    "tactics": {
      "at": 360,
      "steps": [
        {
          "number": 1,
          "at": 547,
          "line": "Dengarkan sampai kalimatnya selesai.",
          "detail": "Hitung pengulangan dan jeda."
        },
        {
          "number": 2,
          "at": 881,
          "line": "Cari siapa yang bisa melihatmu dari tempat aman.",
          "detail": "Tunjuk arah JPO."
        },
        {
          "number": 3,
          "at": 1236,
          "line": "Susuri tembok gang itu tanpa bersuara.",
          "detail": "Berhenti di samping pos berkaca."
        }
      ]
    },
    "ending": {
      "at": 1650,
      "twistAt": 1875,
      "payoff": "Gadis sudah berdiri dekat di pantulan kaca pos."
    }
  },
