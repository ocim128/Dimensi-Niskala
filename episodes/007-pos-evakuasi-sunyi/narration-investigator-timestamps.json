{
  "version": 1,
  "voiceId": "voice_71a5a701-796e-421d-840e-0adc00b0816a",
  "durationSec": 86.215,
  "master": true,
  "chunks": [
    {
      "index": 0,
      "tag": null,
      "text": "Di pos evakuasi, jauhi barisan yang membisu. Pagar stasiun masih tertutup. Lampu berkedip, sirene menyala, dan toa pos mengulang pengumuman.",
      "start": 0,
      "end": 13.345,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 1,
      "tag": null,
      "text": "Orang di dalam berdiri rapi tanpa bicara. Kamu sudah menunggu semalaman. Pertama, cari orang yang benar-benar memberi arahan.",
      "start": 13.505,
      "end": 24.67,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 2,
      "tag": null,
      "text": "Dari luar pagar, kamu dengar toa memanggil nomor antrean yang sama. Tak ada yang menyahut. Kedua, cek jalan keluar sebelum maju.",
      "start": 24.83,
      "end": 36.295,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 3,
      "tag": null,
      "text": "Di samping pagar ada jalan setapak samping rel. Kamu bisa ke sana dengan menyusuri tembok luar pos. Ketiga, kalau memilih mundur, tinggalkan tanda untuk orang berikutnya.",
      "start": 36.455,
      "end": 50.3,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 4,
      "tag": null,
      "text": "Dengan serpihan batu putih, kamu tulis peringatan di beton luar. Jangan ikut barisan. Sirene berhenti.",
      "start": 50.46,
      "end": 60.465,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 5,
      "tag": null,
      "text": "Pagar terbuka pelan. Gadis itu tersenyum dari ujung barisan, dan semua kepala menoleh ke tempat kamu tadi berdiri. Kamu mundur lewat jalur samping rel sampai lampu pos hilang.",
      "start": 60.625,
      "end": 77.29,
      "retries": 1,
      "status": "verified"
    },
    {
      "index": 6,
      "tag": null,
      "text": "Malamnya, sepasang sepatu bot berhenti di depan tulisanmu. Senter menyala. Seseorang membacanya.",
      "start": 77.45,
      "end": 86.215,
      "retries": 2,
      "status": "failed"
    }
  ],
